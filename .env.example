# 复制为 .env 后填写密钥；未填 LLM_API_KEY 时命令行会直接报错。
# 依赖只有 jieba + pytest：不需要数据库、向量库、对象存储、消息队列。

# ---- 模型：OpenAI 兼容协议 ----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---- 语义检索 ----
# 不填 EMBED_BASE_URL/EMBED_API_KEY 时用离线哈希向量兜底，不是真语义
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=256
# 向量后端：留空=哈希兜底；api=走上面的接口；fastembed=本地 bge-small-zh（首次下载约 100MB）
EMBED_PROVIDER=
# 不同后端余弦量纲不同，相关性地板要跟着后端走
EMBED_MIN_SCORE_API=0.45
EMBED_MIN_SCORE_LOCAL=0.55

# 通义千问示例（把 key 填在 EMBED_API_KEY）：
# EMBED_PROVIDER=api
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_MODEL=qwen3.7-text-embedding
# 批量与并发：十万级语料重建时控制请求数
EMBED_BATCH_SIZE=10
EMBED_WORKERS=8

# ---- 检索参数（两阶段 + RRF）----
RETRIEVAL_TOP_K=5
RETRIEVAL_DOC_CANDIDATES=4
RETRIEVAL_RRF_K=60
# 相关性地板：BM25 无命中且余弦低于该值时丢弃
RETRIEVAL_MIN_SEMANTIC_SCORE=0.30

# ---- Agent 预算（到上限返回「未完成」）----
MAX_STEPS=10
MAX_TOOL_CALLS=8
MAX_SUB_QUESTIONS=3

# ---- 调试 ----
# 故障注入，例如 search:1 表示第 1 次检索报错；留空为关闭
FAULT=
